{
  "name": "@braylo/mcp-booking",
  "version": "0.1.0",
  "description": "Local MCP server that reads an .ics file and reports busy time and open booking slots. A documented recurrence subset, not a full calendar suite.",
  "license": "MIT",
  "type": "module",
  "author": "Brandon Lopez (Braylo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/braylo-ai/mcp-server-suite.git",
    "directory": "packages/booking"
  },
  "homepage": "https://github.com/braylo-ai/mcp-server-suite/tree/main/packages/booking",
  "bugs": {
    "url": "https://github.com/braylo-ai/mcp-server-suite/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "calendar",
    "ics",
    "booking"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "mcp-booking": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@braylo/mcp-core": "0.1.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.1.12"
  }
}
